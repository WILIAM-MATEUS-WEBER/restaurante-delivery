# ── Variáveis de Ambiente — RestaurantOS ──────────────────────────────────────
# Copie este arquivo como .env e ajuste os valores antes de rodar em produção.

# Banco de dados
DB_NAME=restaurante
DB_USER=postgres
DB_PASSWORD=postgres123
DB_PORT_EXPOSE=5432

# Aplicação
APP_PORT=5000
SECRET_KEY=mude-esta-chave-em-producao-!@#
FLASK_DEBUG=false

# DockerHub (usado no push da imagem)
DOCKERHUB_USER=seu-usuario-dockerhub
IMAGE_NAME=restaurante-delivery
IMAGE_TAG=latest
